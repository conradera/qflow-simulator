# Supabase (required for persistence and real queue)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# OpenRouter (optional — template messages used when missing or invalid)
OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openrouter/free

# Admin console login (required in production; /display and /register stay public)
ADMIN_PASSWORD=your-secure-admin-password
# ADMIN_SESSION_SECRET=optional-random-string-for-cookie-signing
